{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thinking-of-you",
  "compatibility_date": "2024-12-30",
  // Vite/React SPA built to dist/. Static-asset serving with SPA fallback —
  // deep links like /invite/:token return index.html (200), replacing the
  // Netlify `/* -> /index.html` redirect. VITE_* env vars are inlined at
  // build time, so no runtime secrets are needed here.
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
